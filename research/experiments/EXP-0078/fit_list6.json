   "row_count": 3,
   "cells": 46
  },
  {
   "section": "story",
   "box": 989,
   "rows": [
    "Still... Lord Gawaine, wherever",
    "have you gone?"
   ],
   "row_count": 2,
   "cells": 23
  },
